# Copy this file to .env and fill in real values. .env is git-ignored and never committed.
# cp .env.example .env

# --- Google OAuth 2.0 client -------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must match one of the Authorized redirect URIs registered on that client, character for character.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Session token this application issues after a successful login ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_JWT_SECRET=replace-with-a-random-32-byte-value
SESSION_JWT_TTL_SECONDS=3600

# --- PostgreSQL --------------------------------------------------------------
# Read by docker-compose.yml when the container is created.
POSTGRES_USER=sweng861
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=sweng861_week3

# Read by the application. Host, user, password and database must match the
# three values above.
DATABASE_URL=postgresql+psycopg://sweng861:replace-with-a-local-password@localhost:5432/sweng861_week3

# --- SEC EDGAR (the third-party API, Part 1) ---------------------------------
# EDGAR issues no API key. Its fair-access policy requires a User-Agent naming
# a real person to contact, and answers 403 without one. Not a secret, but it
# carries a personal address and differs per environment, so it is read from
# here rather than committed. Format: "<project or company> <contact email>".
SEC_USER_AGENT=SWENG861 Student Project your-access-id@psu.edu

# --- Tests that need a real database ------------------------------------------
# A separate database from the one the app uses, so a test run cannot delete the
# demo rows the screenshots and the Postman collection point at. Create it with:
#   docker exec -i <db container> psql -U sweng861 -d postgres \
#     -c "CREATE DATABASE sweng861_week3_test OWNER sweng861;"
# Database tests skip when this is unset.
TEST_DATABASE_URL=postgresql+psycopg://sweng861:replace-with-a-local-password@localhost:5432/sweng861_week3_test
