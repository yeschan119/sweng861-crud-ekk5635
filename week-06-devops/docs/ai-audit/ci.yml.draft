name: CI

on:
  push:
  pull_request:

jobs:
  backend:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: week-06-devops/backend
    services:
      postgres:
        image: postgres:17-alpine
        env:
          POSTGRES_USER: sweng861
          POSTGRES_PASSWORD: sweng861
          POSTGRES_DB: sweng861_week6_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U sweng861"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
    env:
      TEST_DATABASE_URL: postgresql+psycopg://sweng861:sweng861@localhost:5432/sweng861_week6_test
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-python@v7
        with:
          python-version: "3.14"
          cache: pip
          cache-dependency-path: week-06-devops/backend/requirements.txt
      - run: pip install -r requirements.txt
      - run: ruff check .
      - run: pytest --cov=.
