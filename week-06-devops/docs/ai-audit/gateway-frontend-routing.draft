# --- gateway/nginx.conf: the API block becomes a regex location, and / goes to the SPA ---
    location ~ ^/(api|auth|health)(/|$) {
        set $upstream http://api:8000;
        proxy_pass $upstream$request_uri;
        # ... the existing proxy headers, timeouts and error_page, unchanged ...
    }

    location / {
        set $frontend http://frontend:8080;
        proxy_pass $frontend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

# --- docker-compose.yml ---
  frontend:
    build:
      context: ../frontend
    image: sweng861-week6-frontend
    expose:
      - "8080"
    restart: unless-stopped

  # api:     environment: FRONTEND_URL: http://localhost:8000
  # gateway: depends_on: frontend
