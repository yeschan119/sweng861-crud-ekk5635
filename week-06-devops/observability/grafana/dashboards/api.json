{
  "uid": "sweng861-api",
  "title": "SWENG 861 · API",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "sweng861",
    "week6"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SLO · Login success rate (target ≥ 99%)",
      "description": "Successful logins over logins that failed for a server-side reason (token exchange, verification, 5xx). Consent declined, expired cookies and forged state are the caller's doing and are left out. No data means no eligible login in the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(logins_total{outcome=\"succeeded\"}[$__range])) / (sum(increase(logins_total{outcome=~\"succeeded|service_error\"}[$__range])) + (sum(increase(http_requests_total{route=\"/auth/callback\",status=~\"5..\"}[$__range])) or vector(0)))",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SLO · API availability, non-5xx (target ≥ 99.5%)",
      "description": "Share of /api/* requests that did not end in 5xx over the selected range. The SLO window is 7 days; set the time picker to 7d to read it as the SLO.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(increase(http_requests_total{route=~\"/api/.*\",status=~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_requests_total{route=~\"/api/.*\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLO · GET /api/coverages p95 (target ≤ 500 ms)",
      "description": "95th percentile latency of GET /api/coverages over the selected range. 0.5 s is a histogram bucket edge, so the target is read exactly.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(http_request_duration_seconds_bucket{route=\"/api/coverages\",method=\"GET\"}[$__range])))",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "Requests per second by route template. Health probes and /metrics scrapes are excluded. A drop to zero with no error spike points at the gateway or the network rather than the API.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(http_requests_total{route!~\"/health.*|/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error rate: 4xx vs 5xx",
      "description": "Share of requests ending in 4xx and in 5xx. A 5xx rise is the service failing; a 4xx rise is usually callers, a bad deploy of the client, or a scan.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{route!~\"/health.*|/metrics\",status=~\"4..\"}[$__rate_interval])) / sum(rate(http_requests_total{route!~\"/health.*|/metrics\"}[$__rate_interval]))",
          "legendFormat": "4xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_requests_total{route!~\"/health.*|/metrics\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_requests_total{route!~\"/health.*|/metrics\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p95 latency by route",
      "description": "p95 latency per route. Compare with the error panel: latency rising before 5xx usually means a slow dependency (database, SEC EDGAR).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{route!~\"/health.*|/metrics\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Coverages created",
      "description": "Coverages committed to the database. Duplicates refused with 409 are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(coverages_created_total[$__rate_interval]))",
          "legendFormat": "created"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Logins by outcome",
      "description": "Logins by outcome. A client_error spike without succeeded falling is likely forged or replayed callbacks; service_error rising is Google or this service failing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(logins_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
